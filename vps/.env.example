# === Telegram bot ===
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAExampleBotToken

# === Lovable web app connection ===
# Your Lovable app URL (published or preview)
LOVABLE_API_URL=https://your-project.lovable.app
# The BOT_API_TOKEN saved in Lovable project secrets (copy the exact value)
BOT_API_TOKEN=paste_your_bot_api_token_here

# === Worker tuning ===
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=30

# === Apify actor (Facebook Ads Library scraper) ===
# The public actor to use. Override if you prefer a different one.
APIFY_FB_ADS_ACTOR=curious_coder/facebook-ads-library-scraper
